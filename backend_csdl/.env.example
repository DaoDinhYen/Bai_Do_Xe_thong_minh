# ===========================
# Smart Parking System - .env
# ===========================

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=smart_parking_jwt_secret_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=smart_parking_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_parking
DB_CONNECTION_LIMIT=10

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart_parking_backend

# MQTT Topics
MQTT_TOPIC_SLOT_PREFIX=parking/esp32_1/slot
MQTT_TOPIC_RFID_IN=parking/esp32_2/rfid/in
MQTT_TOPIC_RFID_OUT=parking/esp32_2/rfid/out
MQTT_TOPIC_GATE_IN=parking/esp32_2/gate/in
MQTT_TOPIC_GATE_OUT=parking/esp32_2/gate/out
MQTT_TOPIC_LIGHT=parking/esp32_2/light
MQTT_TOPIC_DEVICE_STATUS=parking/device/status
MQTT_TOPIC_CMD_GATE_IN=parking/cmd/gate_in
MQTT_TOPIC_CMD_GATE_OUT=parking/cmd/gate_out
MQTT_TOPIC_CMD_LIGHT=parking/cmd/light

# ANPR Service
ANPR_SERVICE_URL=http://localhost:5000
ANPR_CONFIDENCE_THRESHOLD=0.70
ANPR_TIME_WINDOW_SECONDS=30

# Barrier Config
BARRIER_TIMEOUT_SECONDS=15

# Parking Config
WALK_IN_ALLOWED=true
DEFAULT_PRICE_PER_HOUR=10000
MINIMUM_FEE=10000

# Admin default credentials (change after first login)
ADMIN_EMAIL=admin@smartparking.com
ADMIN_PASSWORD=Admin@123456
