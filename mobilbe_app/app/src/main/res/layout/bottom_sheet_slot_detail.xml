<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="24dp">

    <!-- Top Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_badge_disabled"
        android:layout_marginBottom="16dp" />

    <!-- Title Row: Slot Code & Status Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_sheet_slot_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A01"
                android:textColor="@color/navy"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_zone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Khu vực: Khu A"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sheet_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_free"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="Trống"
            android:textColor="@color/status_free"
            android:textSize="@dimen/text_body_sm"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Details Box -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_variant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Price -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá gửi xe:"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="10.000 VNĐ/giờ"
                    android:textColor="@color/navy"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Booking info if occupied or reserved -->
            <RelativeLayout
                android:id="@+id/layout_sheet_booking_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biển số:"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tv_sheet_plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="51A12345"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Action Button (Book now or Close) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sheet_book_now"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Đặt chỗ ngay"
        android:textSize="@dimen/text_subtitle" />
</LinearLayout>
