<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0.5dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Circular Icon Container -->
        <FrameLayout
            android:id="@+id/layout_icon_bg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_free">

            <ImageView
                android:id="@+id/iv_trans_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_wallet"
                app:tint="@color/status_free"
                android:contentDescription="Giao dịch" />
        </FrameLayout>

        <!-- Title & Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_trans_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nạp tiền"
                android:textColor="@color/navy"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_trans_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="10/09/2026 · 09:15"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subtext" />
        </LinearLayout>

        <!-- Amount -->
        <TextView
            android:id="@+id/tv_trans_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+100.000 VNĐ"
            android:textColor="@color/status_free"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
