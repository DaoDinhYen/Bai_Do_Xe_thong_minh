<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Booking Code & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_booking_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="BK20260910001"
                android:textColor="@color/navy"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_booking_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_badge_free"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Đã xác nhận"
                android:textColor="@color/status_free"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Slot & Zone -->
        <TextView
            android:id="@+id/tv_booking_slot_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A01 · Khu A"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Date & Time -->
        <TextView
            android:id="@+id/tv_booking_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="10/09/2026 · 08:00 - 11:00"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_subtext" />

        <!-- Bottom row: Price & Action -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tv_booking_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="30.000 VNĐ"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Chi tiết" />
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
