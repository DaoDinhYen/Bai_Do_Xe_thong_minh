<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_slot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:id="@+id/layout_slot_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/bg_slot_free">

        <ImageView
            android:id="@+id/iv_car_status"
            android:layout_width="48dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_car_top_green"
            android:contentDescription="Xe" />

        <TextView
            android:id="@+id/tv_slot_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A01"
            android:textColor="@color/navy"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_slot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Trống"
            android:textColor="@color/status_free"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
